# ─────────────────────────────────────────────────────────────────────────────
# InnovateX AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="InnovateX AI"
APP_VERSION="1.0.0"
APP_ENV="development"          # development | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# ── Server ────────────────────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000
WORKERS=1                      # increase to cpu_count * 2 + 1 in production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="innovatex_ai"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"

# Constructed automatically in config.py — you can override if needed:
# DATABASE_URL="postgresql+asyncpg://postgres:changeme@localhost:5432/innovatex_ai"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_USE_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USERNAME="apikey"
SMTP_PASSWORD="SG.your_sendgrid_key"
EMAILS_FROM_ADDRESS="noreply@innovatex.ai"
EMAILS_FROM_NAME="InnovateX AI"

# ── Redis (optional — cache / sessions) ───────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── File storage (AWS S3 / compatible) ────────────────────────────────────────
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET="innovatex-ai-uploads"
AWS_S3_REGION="us-east-1"

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=""
